{
  "name": "nx-sk",
  "version": "0.21.0",
  "description": "nx-sk · 本机个人资源管理器（server-cli-web 骨架）：栏目化存储个人信息与大模型密钥，CLI 与 Web 同源，敏感字段密文落盘。",
  "type": "module",
  "bin": {
    "nx-sk": "bin/nx-sk.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZHLX2005/nx-sk.git"
  },
  "homepage": "https://github.com/ZHLX2005/nx-sk#readme",
  "bugs": {
    "url": "https://github.com/ZHLX2005/nx-sk/issues"
  },
  "packageManager": "pnpm@9.12.0",
  "nxSk": {
    "port": 7866,
    "vitePort": 5180
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "link:local": "node scripts/link-local.mjs",
    "unlink:local": "node scripts/link-local.mjs --unlink",
    "dev:vite": "vite",
    "dev:serve": "node bin/nx-sk.mjs serve --no-open",
    "build": "vite build && node scripts/link-local.mjs --auto",
    "start": "pnpm run build && node bin/nx-sk.mjs serve",
    "proto:dev": "vite --config plan/block-refactor/prototype/vite.config.js",
    "proto:build": "vite build --config plan/block-refactor/prototype/vite.config.js",
    "loop:on": "node scripts/rp-loop.mjs on",
    "loop:off": "node scripts/rp-loop.mjs off",
    "loop:status": "node scripts/rp-loop.mjs status",
    "loop:log": "node scripts/rp-loop.mjs log",
    "loop:cancel": "node scripts/rp-loop.mjs cancel",
    "lint": "eslint .",
    "test:unit": "node --test",
    "test:smoke": "node tests/smoke.mjs",
    "test": "pnpm run lint && pnpm run build && pnpm run test:smoke && pnpm run test:unit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "flexlayout-react": "0.11.1",
    "vite": "^6.0.7"
  }
}
