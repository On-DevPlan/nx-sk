node_modules/
dist/
*.log
.tmp/
.DS_Store

# 本机数据目录的镜像（真实数据在 ~/nx-sk/，绝不入库）
# `store.json.*` 不能省：`store.json` 只匹配这一个名字，而备份/迁移副本叫
# store.json.pre-kv-backup / store.json.imported-<ts> 这种——漏了它，一份整库 PII 就可能被 add 进来。
store.json
store.json.*
# 0.36 起主存储是 SQLite：库本体 + WAL 附属 + stale/imported 留证副本，全套挡掉。
nxsk.db
nxsk.db-wal
nxsk.db-shm
nxsk.db-journal
nxsk.db.*
migration-failed-*.log
*.vaultkey
*.vaultsalt

# 个人信息（PII）绝不入库：一旦 push 到远端就收不回来了
*-个人信息.txt
seed/

# agent 的工作笔记（含个人信息状态的描述），留在本机
.workbuddy/
.pdf

# 用户放进项目目录的本地文件（截图 / 简历 / 表格…往往含 PII）绝不入库。
# 只挡项目根，不影响 src/ 与 assets/ 下正常资源。
/*.pdf
/*.png
/*.jpg
/*.jpeg
/*.docx
/*.xlsx
/*.zip
workbuddy-ai/
.workbuddy-ai/

# ---- 个人版文档：连子目录一起挡（上面那组只挡项目根，assets/ 下的个人文件会漏）----
# 排出来的「填好的」毕业论文、求职简历、成绩单等都用这些扩展名。
# 仓库只留**占位符版**空白模板（身份字段是 {{student}} / {{studentId}}），
# 填好的版本请用 --out 写到仓库之外，别 add 进来。
*.docx
*.xlsx
*.pptx
!assets/nx-sk/templates/毕业论文模板-设计开发类.docx

# 证件 / 简历 / 证件照类文件名——就算改了扩展名也挡住。
*身份证*
*证件*
*人像面*
*简历*
*学位证*
*毕业照*

# ============================================================
# Cloned repositories (nested git repos) — sl-git-standard
# 父目录必须用 /* 半透明模式，否则否定规则失效
# ============================================================
.claude/repo/*

!.claude/repo/_read/
!.claude/repo/_read/**

!.claude/repo/_self/
!.claude/repo/_self/**

# .claude/www/git.remote 清单是仓库内容，随宿主提交（sl-git-standard）——
# 故意不写忽略规则：清单随仓库走，换机器/同事 clone 后 sync 才有输入

# Tool artifacts / scratch tools (本地工具产物，不入库)
.tool/

# 验证脚本与截图（含真实库数据的页面截图，PII）；临时测试 home 目录
/temp/
/.tmp-*/

# Python 脚本运行产物（nx-sk 的论文模板生成器等）
__pycache__/
*.pyc
