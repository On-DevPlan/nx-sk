{
  "name": "ts-lsp",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript language server (typescript-language-server) —— hover / goToDefinition / findReferences / documentSymbol / rename",
  "lspServers": {
    "typescript": {
      "command": "npx",
      "args": ["--no-install", "typescript-language-server", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript"
      },
      "startupTimeout": 120000,
      "requestTimeout": 120000,
      "restartOnCrash": true,
      "maxRestarts": 3,
      "diagnostics": true,
      "initializationOptions": {
        "tsserver": {
          "tsdk": "${CLAUDE_PROJECT_DIR}/node_modules/typescript/lib",
          "logDirectory": "${CLAUDE_PLUGIN_DATA}/tsserver-logs",
          "plugins": []
        }
      }
    }
  }
}
